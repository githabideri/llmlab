# Example environment for llama-server
# Mirrors the current dual-3060 Qwen3.6-35B-A3B production defaults (2026-08).
# Adjust model path / GPU count per deployment; keep flags stable between benchmark runs.
MODEL_PATH=/mnt/models/gguf/qwen3.6-35b-a3b-mtp/Qwen3.6-35B-A3B-UD-IQ4_XS.gguf
CUDA_VISIBLE_DEVICES=0,1
CTX_SIZE=262144
BATCH=2048
UBATCH=1024
TENSOR_SPLIT=50,50
SPLIT_MODE=tensor
N_CPU_MOE=0
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q4_0
FLASH_ATTN=1
PARALLEL=2
SPEC_TYPE=draft-mtp
SPEC_DRAFT_N_MAX=3
