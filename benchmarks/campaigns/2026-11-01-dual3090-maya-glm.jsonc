        "--model", "glm-5.3-flash", "--mode", "warmup",
        "--ctx-k", "2", "--ntok", "64", "--chat", "--json-out", "{cell}/client.json"]},
      "launch": {"binary": "/opt/maya/.venv/bin/python3", "args": [
        "/root/maya-1.1.48/serve/server.py", "--engine", "maya",
        "--config", "/root/campaign/cfg-maya.json", "--port", "{port}"]},
