  },
  "workload": {
    "client": "openai-compatible serve layer (bench-vllm client)",
    "notes": "Fixed seed. Decode is (completion_tokens - 1) / decode_wall. Concurrency cells require the overlap proof. Recall cells plant facts at fixed context fractions plus a negative control. The engine is configured with the parallel flag at 4 sequences; a cell where N > configured parallelism is expected to serialize and is reported as such, not as a pass."
  },
  "client": {
    "script": "clients/bench-vllm.py",
    "args": ["python3", "{bundle}/clients/bench-vllm.py",
