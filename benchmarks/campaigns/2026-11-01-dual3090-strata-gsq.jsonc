  },
  "workload": {
    "client": "openai-compatible serve layer (bench-vllm client)",
    "notes": "Fixed seed. Decode is (completion_tokens - 1) / decode_wall, the platform definition, never a server-reported rate. Concurrency cells require the overlap proof: N requests must actually overlap in time, otherwise a serialized engine scores as if it were parallel. Recall cells plant facts at fixed context fractions and ask for them plus a negative control (a fact not present in the text)."
  },
  "client": {
    "script": "clients/bench-vllm.py",
    "args": ["python3", "{bundle}/clients/bench-vllm.py",
